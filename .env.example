APP_NAME=hospital-allocation-system
ENVIRONMENT=local

# Postgres (used by docker-compose; local dev/test defaults to SQLite if unset)
DATABASE_URL=postgresql+psycopg2://hospital:hospital@localhost:5432/hospital

# Chroma
CHROMA_PERSIST_DIR=./.chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# LLM / embeddings — provider priority is Google AI Studio > Azure OpenAI > local offline
# fallback (see app/llm.py, app/rag/embeddings.py). TODO(pre-production): set real
# credentials for whichever provider you use. Left blank here.
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004
GOOGLE_CHAT_MODEL=gemini-1.5-flash
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

HUMAN_APPROVAL_THRESHOLD=0.70
MAX_AGENT_RETRIES=3

# TODO(pre-production): replace with real auth (this is a stub API-key check).
API_KEY=dev-local-api-key

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
