APP_NAME=hospital-allocation-system
ENVIRONMENT=local

# Postgres (used by docker-compose; local dev/test defaults to SQLite if unset)
DATABASE_URL=postgresql+psycopg2://hospital:hospital@localhost:5432/hospital

# Chroma
CHROMA_PERSIST_DIR=./.chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# LLM / embeddings — TODO(pre-production): set real Azure/OpenAI credentials.
# Left blank here; RAG + agents fall back to local/offline behavior without them.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

HUMAN_APPROVAL_THRESHOLD=0.70
MAX_AGENT_RETRIES=3

# TODO(pre-production): replace with real auth (this is a stub API-key check).
API_KEY=dev-local-api-key

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
